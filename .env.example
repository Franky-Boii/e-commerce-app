# Frontend (Vite) — copy this file to .env.local and fill in real values
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Edge Function secrets — set these with:
#   supabase secrets set PAYFAST_MERCHANT_ID=xxx
# Do NOT put these in the frontend .env — they are backend-only.
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_MODE=sandbox
SITE_URL=http://localhost:5173
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key